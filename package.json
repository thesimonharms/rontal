{
  "name": "rontal",
  "version": "0.1.0",
  "description": "Headless blog API for Pondoknusa — bring your own frontend. The Old Javanese ancestor of lontar.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --experimental-strip-types tests/**/*.test.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@pondoknusa/core": "^3.0.0",
    "@pondoknusa/database": "^3.0.0",
    "@pondoknusa/http": "^3.0.0",
    "@pondoknusa/support": "^3.0.0",
    "@pondoknusa/validation": "^3.0.0",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesimonharms/rontal.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "blog",
    "cms",
    "headless",
    "pondoknusa",
    "api",
    "markdown"
  ]
}
